<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Volume collects nothing. There is no account, no analytics, no advertising and no
	  third-party SDKs. Workouts live on the device and, if the user is signed into iCloud,
	  in their own private CloudKit database — which is their storage, not data collected by
	  the developer, so it is not declared below.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  Core/AppSettings.swift stores appearance, units, onboarding completion and
			  the debug unlock flag. CA92.1 = the app's own defaults, never shared with or
			  read by anything else.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
